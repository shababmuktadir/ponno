# ============================================================
# FIREBASE — copy values from Firebase Console → Project Settings
# Client-safe (still protected by Firestore Rules + Auth)
# ============================================================
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ============================================================
# CLOUDINARY (only cloud name + unsigned preset needed)
# ============================================================
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
VITE_CLOUDINARY_FOLDER=your_folder

# ============================================================
# FIRESTORE NETWORK
# Set to "true" for ISP-friendly HTTP long-polling
# ============================================================
VITE_FIRESTORE_FORCE_LONG_POLLING=true

# ============================================================
# CLOUDFLARE WORKER (SMS + Email proxy)
# Deploy worker first, then paste its URL here
# Example: https://pm-api.yourname.workers.dev
# ============================================================
VITE_SERVERLESS_BASE_URL=